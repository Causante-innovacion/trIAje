# =============================================================================
# GPT Legal - Variables de Entorno
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas el archivo .env al repositorio
# =============================================================================

# 🔑 OpenAI API Key
OPENAI_API_KEY=sk-tu-api-key-aqui

# 🔐 ChromaDB Token de Autenticación
# Genera un token seguro con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Este token se usa para:
#   - El servidor ChromaDB (CHROMA_SERVER_AUTHN_CREDENTIALS)
#   - El backend para conectarse a ChromaDB (CHROMA_TOKEN)
# ⚠️  CAMBIA este valor antes de desplegar a producción
CHROMA_TOKEN=CAMBIA-ESTO-genera-un-token-seguro-con-el-comando-de-arriba

# 🤖 Otros proveedores de IA (opcionales)
# ANTHROPIC_API_KEY=sk-ant-tu-key-aqui
# MAPLE_API_KEY=tu-maple-key-aqui
