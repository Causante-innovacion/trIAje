# GPT Legal - Environment Variables

# =============================================================================
# PROJECT
# =============================================================================
PROJECT_NAME=GPT Legal
VERSION=0.1.0
DEBUG=true

# =============================================================================
# DATABASE
# =============================================================================
# SQLite for development
DATABASE_URL=sqlite+aiosqlite:///./gpt_legal.db

# PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gpt_legal

# =============================================================================
# VECTOR STORE - ChromaDB
# =============================================================================
VECTOR_STORE_TYPE=chroma

# Modo: local (persistente), server (HTTP), memory (testing)
CHROMA_MODE=local
CHROMA_PERSIST_DIR=../RAG/chroma_db

# Para modo servidor (producción)
# CHROMA_MODE=server
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_TOKEN=tu-token-seguro-aqui  (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))")


# =============================================================================
# AI PROVIDERS
# =============================================================================
# OpenAI (requerido para embeddings y LLM)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (opcional, para creatividad)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Maple AI (alternativa más segura para datos sensibles)
# MAPLE_API_KEY=your-maple-key-here
# MAPLE_API_URL=https://api.maple.ai/v1

# Provider preferido: openai, maple, anthropic
AI_PROVIDER_PRIMARY=openai
AI_PROVIDER_FALLBACK=openai

# =============================================================================
# AI MODELS
# =============================================================================
MODEL_INTAKE=gpt-4o-mini
MODEL_REASONING=gpt-4o
MODEL_CREATIVITY=claude-sonnet-4-20250514

# =============================================================================
# EMBEDDINGS
# =============================================================================
# Provider: openai, local (sentence-transformers)
# IMPORTANTE: Usar "local" para que coincida con los embeddings de RAG/chroma_db
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_MODEL=paraphrase-multilingual-mpnet-base-v2

# =============================================================================
# RAG PARAMETERS
# =============================================================================
RAG_TOP_K_INITIAL=20
RAG_TOP_K_RERANK=8
RAG_MAX_CHUNK_TOKENS=600
RAG_CHUNK_OVERLAP=120
RAG_CONFIDENCE_THRESHOLD=0.65
RAG_STRICTNESS=3

# Scoring weights (deben sumar 1.0)
SCORE_SEMANTIC_SIMILARITY=0.35
SCORE_AUTHORITY_WEIGHT=0.25
SCORE_RECENCY_WEIGHT=0.15
SCORE_JURISDICTION_MATCH=0.15
SCORE_LEGAL_TERM_DENSITY=0.10

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
