# GPT Legal - Environment Variables

# Project
PROJECT_NAME=GPT Legal
VERSION=0.1.0
DEBUG=true

# Database
# SQLite for development
DATABASE_URL=sqlite+aiosqlite:///./gpt_legal.db

# PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gpt_legal

# Vector Store (implementar según elección)
VECTOR_STORE_TYPE=none  # none, pgvector, pinecone, qdrant
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# AI Providers
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# AI Models
MODEL_INTAKE=gpt-4o-mini
MODEL_REASONING=gpt-4o
MODEL_CREATIVITY=claude-sonnet-4-20250514

# RAG Parameters
RAG_TOP_K_INITIAL=20
RAG_TOP_K_RERANK=8
RAG_CONFIDENCE_THRESHOLD=0.65
RAG_STRICTNESS=3

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
